{
  "name": "xs-components",
  "type": "module",
  "version": "1.0.8",
  "workspaces": [
    "packages",
    "docs",
    "effect",
    "build"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "ct": "bash ./script/template.sh",
    "clean": "rimraf ./dist",
    "dev": "pnpm run -C effect dev",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "log": "conventional-changelog -p cmyr-config -i CHANGELOG.md -s -r 0",
    "type:web": "vue-tsc -p tsconfig.web.json --composite false --noEmit",
    "type:node": "tsc -p tsconfig.node.json --composite false --noEmit",
    "docs:dev": "pnpm run -C docs dev",
    "docs:build": "pnpm run -C docs build",
    "docs:serve": "pnpm run -C docs serve",
    "build": "pnpm run -C build build",
    "lint:eslint": "eslint . --fix",
    "lint:prettier": "prettier . --write",
    "lint:stylelint": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "lint:staged": "lint-staged",
    "cz": "czg",
    "prepare": "husky",
    "release": "bump package.json packages/package.json docs/package.json"
  },
  "dependencies": {
    "@jsxiaosi/utils": "^0.0.19",
    "@vueuse/core": "^13.5.0"
  },
  "devDependencies": {
    "@jsdevtools/version-bump-prompt": "^6.1.0",
    "@jsxiaosi/commitlint-config": "^1.0.11",
    "@jsxiaosi/eslint-config": "^1.0.11",
    "@jsxiaosi/eslint-config-prettier": "^1.0.11",
    "@types/node": "*",
    "@vitest/coverage-c8": "^0.32.2",
    "@vue/test-utils": "^2.4.6",
    "chalk": "^5.4.1",
    "commitlint": "^19.8.1",
    "consola": "^3.4.2",
    "conventional-changelog-cli": "^5.0.0",
    "czg": "^1.12.0",
    "eslint": "^9.31.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-vue": "^10.3.0",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-import": "^16.1.1",
    "postcss-pxtorem": "^6.1.0",
    "prettier": "3.6.2",
    "sass": "^1.89.2",
    "stylelint": "^16.21.1",
    "stylelint-config-property-sort-order-smacss": "^10.0.0",
    "stylelint-config-recommended": "^16.0.0",
    "stylelint-config-recommended-scss": "^15.0.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.12.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.17",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "rollup",
        "source-map-*",
        "stable",
        "uuid",
        "vite*",
        "urix"
      ]
    }
  },
  "peerDependencyRules": {
    "ignoreMissing": [
      "vite"
    ]
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{!(package)*.json,*.code-snippets,.!(browserslist)*rc}": [
      "prettier --write--parser json"
    ],
    "package.json": [
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix",
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{scss,less,styl,html}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
